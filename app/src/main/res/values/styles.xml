<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="HeaderLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="heading">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AssetNo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:hint">Asset Number</item>
        <item name="android:inputType">number</item>
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:background">@drawable/editbox</item>
        <item name="android:paddingStart">5dp</item>
    </style>

    <style name="AssetDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:hint">Asset Description</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/editbox</item>
        <item name="android:paddingStart">5dp</item>
    </style>

    <style name="AssetCategory">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:hint">Asset Category</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/editbox</item>
        <item name="android:paddingStart">5dp</item>
    </style>

    <style name="AssetLocation">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:hint">Asset Location</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/editbox</item>
        <item name="android:paddingStart">5dp</item>
    </style>

    <style name="Save">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
       <item name="android:text">Save Asset</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>

    <style name="Cancel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:text">Cancel</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>

    <style name="Textview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>